{
  "name": "netoze-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --import tsx --test src/lib/*.test.ts src/components/*.test.ts && node --test scripts/*.test.mjs",
    "test:geo": "node --import tsx --test src/lib/countryIndex.test.ts src/lib/geo.test.ts src/components/globeGeometry.test.ts",
    "preview": "vite preview",
    "desktop:dev": "tauri dev",
    "stage:release": "node scripts/stage-native-release.mjs",
    "dist:release": "node scripts/build-desktop.mjs",
    "dist:windows": "node scripts/build-desktop.mjs windows",
    "dist:windows:cross": "node scripts/build-desktop.mjs windows --cross",
    "dist:linux": "node scripts/build-desktop.mjs linux",
    "test:release": "node --test scripts/native-release.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@types/three": "^0.185.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.29.0",
    "mongoose": "^9.9.1",
    "nodemailer": "^9.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.14.5",
    "moment-timezone": "^0.6.3",
    "oxlint": "^1.75.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
