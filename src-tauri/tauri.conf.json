{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "NET0ZE",
  "version": "2.0.0",
  "identifier": "io.netoze.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "NET0ZE — Enterprise NTA & IDS Desktop Cybersecurity Platform",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#050505"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://127.0.0.1:5173 http://127.0.0.1:5173 ipc: http://ipc.localhost;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "publisher": "NET0ZE Security Team",
    "shortDescription": "NET0ZE Desktop NTA & IDS Platform",
    "longDescription": "Real-time Network Traffic Analysis, TLS JA4 Fingerprinting, Rule Evaluation, Attack Graph, and Forensic Workbench for Windows and Linux.",
    "resources": {
      "resources/WebView2Loader.dll": "WebView2Loader.dll"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
